// Copy this file to arduino_secrets.h (same folder as the sketch) and fill in
// your own values. arduino_secrets.h is gitignored, so the SIM PIN and phone
// numbers never end up on GitHub.

#define SECRET_PINNUMBER      "0000"            // SIM card PIN ("" if the SIM has no PIN)
#define SECRET_PHONE_NUMBER   "00447000000000"  // primary recipient of all SMS alerts
#define SECRET_PHONE_NUMBER_2 ""                // optional second recipient ("" = unused)
